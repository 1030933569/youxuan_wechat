.page {
  padding: 20rpx;
  padding-bottom: 140rpx;
}

.swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}

.swiper-img {
  width: 100%;
  height: 520rpx;
}

.info {
  margin-top: 20rpx;
  padding: 24rpx;
}

.badge-row {
  margin-bottom: 14rpx;
}

.community-badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eff8ff;
  color: #4facfe;
  font-size: 22rpx;
  font-weight: 700;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
}

.row {
  margin-top: 14rpx;
  align-items: flex-end;
}

.price-block {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 22rpx;
  color: #4facfe;
}

.price {
  font-size: 40rpx;
  font-weight: 800;
}

.community-note {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f6fbff;
}

.community-note-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2d3d;
}

.community-note-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5d6b7a;
  line-height: 1.7;
}

.community-features {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.feature-tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #cfe6ff;
  color: #4facfe;
  font-size: 22rpx;
}

.actions {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 24rpx;
  display: flex;
  gap: 16rpx;
}

.primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #4facfe;
  color: #fff;
  font-size: 30rpx;
}

.ghost {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #fff;
  color: #4facfe;
  border: 2rpx solid #4facfe;
  font-size: 30rpx;
}
