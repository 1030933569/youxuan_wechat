.page {
  padding: 20rpx;
  padding-bottom: 140rpx;
}

.swiper {
  width: 100%;
  height: 520rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}

.swiper-img {
  width: 100%;
  height: 520rpx;
}

.info {
  margin-top: 20rpx;
  padding: 24rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
}

.row {
  margin-top: 14rpx;
  align-items: flex-end;
}

.price-block {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 22rpx;
  color: #4facfe;
}

.price {
  font-size: 40rpx;
  font-weight: 800;
}

.origin-price {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8e99a8;
  text-decoration: line-through;
}

.group-panel {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #fff8ef 0%, #fff2e0 100%);
}

.group-copy {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a2b12;
}

.group-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: #7d5b41;
}

.pricing-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.pricing-card {
  padding: 18rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pricing-card.active {
  border-color: #ff9a3c;
  box-shadow: 0 10rpx 24rpx rgba(255, 154, 60, 0.12);
}

.pricing-card-base {
  background: rgba(255, 255, 255, 0.62);
}

.pricing-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #4a2b12;
}

.pricing-price {
  font-size: 30rpx;
  font-weight: 800;
  color: #ff7f32;
}

.pricing-desc {
  font-size: 20rpx;
  line-height: 1.5;
  color: #7d5b41;
}

.group-options {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.group-option {
  flex: 1;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.group-option.active {
  border-color: #ff9a3c;
  box-shadow: 0 10rpx 24rpx rgba(255, 154, 60, 0.12);
}

.group-option-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a2b12;
}

.group-option-desc {
  font-size: 22rpx;
  color: #7d5b41;
  line-height: 1.5;
}

.group-start {
  margin-top: 20rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 41rpx;
  border: none;
  background: linear-gradient(135deg, #ffb14f 0%, #ff7f32 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.actions {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 24rpx;
  display: flex;
  gap: 16rpx;
}

.primary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #4facfe;
  color: #fff;
  font-size: 30rpx;
}

.ghost {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #fff;
  color: #4facfe;
  border: 2rpx solid #4facfe;
  font-size: 30rpx;
}
