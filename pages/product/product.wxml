<view class="page">
  <swiper class="swiper" indicator-dots="{{images.length > 1}}" circular>
    <swiper-item wx:for="{{images}}" wx:key="imgUrl">
      <image class="swiper-img" src="{{item.imgUrl}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <view class="card info">
    <view class="badge-row">
      <text class="community-badge">社区团购商品</text>
    </view>
    <view class="name">{{skuInfo.skuName}}</view>
    <view class="row flex-between">
      <view class="price-block">
        <text class="price-label">社区拼单价</text>
        <text class="price text-red">¥{{skuInfo.price}}</text>
      </view>
      <text class="text-muted">库存：{{skuInfo.stock}} 已售：{{skuInfo.sale}}</text>
    </view>
    <view class="community-note">
      <text class="community-note-title">社区团购说明</text>
      <text class="community-note-desc">社区居民围绕社区提货点集中拼单，由社区团长组织配送与自提，人数越多价格越优。</text>
      <view class="community-features">
        <text class="feature-tag">社区拼单</text>
        <text class="feature-tag">团长组织</text>
        <text class="feature-tag">统一自提</text>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="primary" bindtap="addToCart">加入购物车</button>
    <button class="ghost" bindtap="gotoCart">去购物车</button>
  </view>
</view>
