<view class="page container">
  <view wx:if="{{records.length === 0}}" class="empty text-muted">暂无订单</view>

  <view wx:else>
    <view class="order card" wx:for="{{records}}" wx:for-item="order" wx:key="id">
      <view class="head flex-between">
        <view class="meta">
          <text class="time">{{order.createTime}}</text>
          <text class="order-no">订单号：{{order.orderNo}}</text>
        </view>

        <view class="status-group">
          <text wx:if="{{order.groupStatusText}}" class="group-status {{order.groupStatus === 'success' ? 'success' : ''}}">{{order.groupStatusText}}</text>
          <text class="status">{{order.param.orderStatusName}}</text>
        </view>
      </view>

      <view wx:if="{{order.groupStatusText}}" class="group-card">
        <view class="group-card-top">
          <view class="group-copy">
            <text class="group-progress">{{order.groupProgressText}}</text>
            <text wx:if="{{order.pricingLabel}}" class="pricing-label">{{order.pricingLabel}} · 合计 ¥{{order.totalAmountText}}</text>
            <text class="community-text">{{order.communityText}}</text>
          </view>
          <button
            wx:if="{{order.showGroupInvite}}"
            class="invite-btn"
            size="mini"
            bindtap="onInviteGroup"
            data-order-no="{{order.orderNo}}"
          >
            邀请邻里参团
          </button>
        </view>
      </view>

      <view class="sku" wx:for="{{order.orderItemList}}" wx:for-item="sku" wx:key="skuId">
        <image class="thumb" src="{{sku.imgUrl}}" mode="aspectFill"></image>
        <view class="sku-content">
        <view class="sku-name">{{sku.skuName}}</view>
        <view class="flex-between">
            <text class="text-red">¥{{sku.displaySkuPrice || sku.skuPrice}}</text>
            <text class="text-muted">x{{sku.skuNum}}</text>
          </view>
        </view>
      </view>

      <view class="total flex-between">
        <view>
          <text class="text-muted">{{order.pricingLabel || '合计'}}</text>
          <text wx:if="{{order.pricingLabel}}" class="origin-total">原价 ¥{{order.originalTotalAmountText}}，省 ¥{{order.savingsAmountText}}</text>
        </view>
        <text class="text-red">¥{{order.totalAmountText || order.totalAmount}}</text>
      </view>

      <view class="actions" wx:if="{{order.canPay}}">
        <button
          class="pay-btn"
          size="mini"
          bindtap="onPayOrder"
          data-order-id="{{order.id}}"
          data-order-no="{{order.orderNo}}"
          data-total-amount="{{order.payTotalAmount || order.totalAmount}}"
          data-receiver-name="{{order.receiverName}}"
          data-pricing-label="{{order.pricingLabel}}"
        >
          去支付
        </button>
      </view>
    </view>

    <view class="load text-muted" wx:if="{{loading}}">加载中...</view>
    <view class="load text-muted" wx:else>{{hasMore ? '上拉加载更多' : '没有更多了'}}</view>
  </view>
</view>
