.order {
  padding: 18rpx;
  margin-bottom: 20rpx;
}

.head {
  align-items: flex-start;
  gap: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f2f2f2;
}

.meta {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.time {
  color: #666;
  font-size: 24rpx;
}

.order-no {
  color: #999;
  font-size: 22rpx;
}

.status-group {
  display: flex;
  align-items: center;
}

.status {
  color: #4facfe;
  font-size: 24rpx;
  font-weight: 600;
}

.sku {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f2f2f2;
}

.sku:last-child {
  border-bottom: none;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.sku-content {
  flex: 1;
}

.sku-name {
  font-weight: 600;
  margin-bottom: 10rpx;
}

.total {
  padding-top: 12rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
}

.pay-btn {
  margin: 0;
  min-width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a3c 0%, #ff6a3d 100%);
  color: #fff;
  font-size: 24rpx;
}

.load {
  text-align: center;
  padding: 16rpx 0 32rpx;
}
