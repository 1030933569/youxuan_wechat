.page {
  padding-bottom: 120rpx;
}

.pickup {
  margin: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
}

.pickup-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.label {
  color: #4facfe;
  font-size: 24rpx;
  font-weight: 700;
}

.name {
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.pickup-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #888;
  line-height: 1.6;
}

.arrow {
  margin-left: 16rpx;
  color: #bbb;
  font-size: 32rpx;
}

.community-banner {
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  border: 2rpx solid #dceeff;
  background: linear-gradient(135deg, #eff8ff 0%, #ffffff 100%);
}

.community-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.community-badge {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #4facfe;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.community-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2d3d;
  line-height: 1.4;
}

.community-desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5d6b7a;
  line-height: 1.7;
}

.community-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.community-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cfe6ff;
  background: #fff;
  color: #4facfe;
  font-size: 22rpx;
}

.apply-leader-section {
  margin: 0 20rpx 20rpx;
  padding: 26rpx 24rpx;
}

.apply-note {
  display: block;
  margin-bottom: 18rpx;
  color: #666;
  font-size: 24rpx;
  line-height: 1.6;
}

.apply-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #4facfe;
  color: #fff;
  font-size: 32rpx;
  border-radius: 40rpx;
  border: none;
}

.apply-btn::after {
  border: none;
}

.category-sv {
  margin: 0 20rpx;
  padding: 10rpx 0;
}

.category-list {
  display: flex;
}

.category-item {
  width: 140rpx;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.category-item.active .category-img {
  border: 4rpx solid #4facfe;
  box-sizing: border-box;
}

.category-item.active .category-name {
  color: #4facfe;
  font-weight: 700;
}

.category-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #fff;
}

.category-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #555;
}

.section-title {
  margin: 30rpx 20rpx 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #4facfe;
}
