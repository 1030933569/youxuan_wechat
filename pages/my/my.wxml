<view class="page">
  <view class="profile-card">
    <view class="avatar">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <text wx:else class="avatar-text">我</text>
    </view>
    <view class="profile-info">
      <text class="nickname">{{userInfo.nickName}}</text>
      <text class="phone">{{hasToken ? userInfo.phone : '登录后查看订单与提货信息'}}</text>
    </view>
    <button wx:if="{{!hasToken}}" class="login-btn" size="mini" bindtap="onLoginTap">登录</button>
  </view>

  <view class="stats-card card">
    <view class="stat-item" wx:for="{{orderStats}}" wx:key="label" bindtap="onOrderTap">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <view class="pickup-card card" bindtap="onPickupTap">
    <view class="card-title-row">
      <text class="card-title">当前提货点</text>
      <text class="link-text">更换</text>
    </view>
    <text class="pickup-name">{{pickupLocation.takeName}}</text>
    <text class="pickup-address">{{pickupLocation.detailAddress}}</text>
    <text class="leader-name">团长：{{pickupLocation.leaderName}}</text>
  </view>

  <view class="menu-card card">
    <view class="menu-item" bindtap="onOrderTap">
      <text class="menu-title">我的订单</text>
      <text class="menu-desc">查看订单状态和商品明细</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onPickupTap">
      <text class="menu-title">我的提货点</text>
      <text class="menu-desc">查看或切换社区自提点</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onCartTap">
      <text class="menu-title">购物车</text>
      <text class="menu-desc">继续结算已选择商品</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item last" bindtap="onApplyLeaderTap">
      <text class="menu-title">申请团长</text>
      <text class="menu-desc">提交社区提货点申请</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>
