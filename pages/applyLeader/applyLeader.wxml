<view class="page">
  <view class="hero card">
    <text class="hero-badge">社区团长</text>
    <text class="hero-title">申请成为社区团长</text>
    <text class="hero-desc">为本社区居民组织集中拼单，统一配送到社区提货点，让社区团购更高效、更便利。</text>
  </view>

  <view class="form">
    <view class="form-item">
      <text class="label">社区提货点名称</text>
      <input class="input" placeholder="请输入社区提货点名称" value="{{takeName}}" bindinput="onTakeNameInput"></input>
    </view>

    <view class="form-item">
      <text class="label">社区提货点详细地址</text>
      <input class="input" placeholder="请输入社区提货点详细地址" value="{{detailAddress}}" bindinput="onDetailAddressInput"></input>
    </view>

    <view class="location-info">
      <text class="label">社区服务位置</text>
      <text class="value" wx:if="{{latitude && longitude}}">{{latitude}}, {{longitude}}</text>
      <text class="value" wx:else>定位获取中...</text>
    </view>

    <button class="submit-btn" type="primary" bindtap="onSubmit" loading="{{loading}}">提交社区团长申请</button>
  </view>
</view>
