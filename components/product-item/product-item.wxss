.product {
  display: flex;
  padding: 20rpx;
  margin: 20rpx;
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  flex-shrink: 0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.tag-row {
  margin-bottom: 8rpx;
}

.community-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eff8ff;
  color: #4facfe;
  font-size: 20rpx;
  font-weight: 700;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.subtext {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.meta {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.bottom {
  margin-top: 16rpx;
}

.price-wrap {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 20rpx;
  color: #4facfe;
}

.price {
  font-size: 32rpx;
  font-weight: 700;
}

.add-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #4facfe;
  color: #fff;
  font-size: 24rpx;
}
